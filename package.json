{
  "name": "llama-manager",
  "version": "1.0.3",
  "description": "Simple Electron app to manage and run llama.cpp server",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.2",
    "katex": "^0.18.4",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.llamamanager.app",
    "productName": "Llama.cpp Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    }
  }
}